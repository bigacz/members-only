<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Message board</title>
</head>

<body>
  <% locals.messages.forEach((message) => { %>
  <div>
    <h2><%= message.title %></h2>
    <p><%= message.message_text %></p>
    <% if (locals.user.is_member) { %>
    <p><%=`By: ${message.firstname} ${message.lastname}`%></p>
    <p><%= new Date(Number(message.timestamp)).toLocaleString('en-EN', { weekday: "long", year: 'numeric', month: 'long', day: "numeric" }); %></p>
    <% } %>
  </div>
  <%}) %>
</body>

</html>